{
  "name": "whale-girl-hud",
  "version": "1.4.0",
  "type": "module",
  "description": "A cut-out whale-girl maid desktop pet in the corner; click her to see the account credit, drag her to move.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "whale-girl",
    "cordis"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.png",
    "assets/pet.webp",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrh-byte/Whale-girl-hud.git"
  },
  "homepage": "https://github.com/wrh-byte/Whale-girl-hud#readme",
  "bugs": {
    "url": "https://github.com/wrh-byte/Whale-girl-hud/issues"
  }
}
